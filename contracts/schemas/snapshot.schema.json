{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://think-fast.local/contracts/v1/snapshot.schema.json",
  "title": "MatchSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "match_id", "room_id", "state", "rules",
    "server_time", "started_at", "deadline", "viewer", "participants",
    "own_attempts", "challenge_setup", "result", "latest_sequence", "available_actions"
  ],
  "properties": {
    "contract_version": {"const": "v1.0.0-draft.1"},
    "match_id": {"type": "string", "format": "uuid"},
    "room_id": {"type": ["string", "null"], "format": "uuid"},
    "state": {"enum": ["setup", "waiting", "ready_check", "countdown", "active", "finishing", "finished", "cancelled", "abandoned", "voided"]},
    "rules": {"$ref": "ruleset.schema.json"},
    "server_time": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "deadline": {"type": ["string", "null"], "format": "date-time"},
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "display_name", "role"],
      "properties": {
        "participant_id": {"type": "string", "format": "uuid"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 20},
        "role": {"enum": ["player", "host"]}
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "display_name", "avatar_id", "connection_state", "attempt_count", "solve_state"],
        "properties": {
          "participant_id": {"type": "string", "format": "uuid"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 20},
          "avatar_id": {"type": "string", "minLength": 1},
          "connection_state": {"enum": ["connected", "disconnected", "abandoned"]},
          "attempt_count": {"type": "integer", "minimum": 0},
          "solve_state": {"enum": ["playing", "solved", "unsolved", "abandoned"]},
          "solve_duration_seconds": {"type": ["integer", "null"], "minimum": 0},
          "score": {"type": "integer", "minimum": 0},
          "round_score": {"type": "integer", "minimum": 0},
          "round_rank": {"type": ["integer", "null"], "minimum": 1},
          "is_creator": {"type": "boolean"}
        }
      }
    },
    "own_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "ordinal", "guess", "feedback", "accepted_at", "solved"],
        "properties": {
          "attempt_id": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 1},
          "guess": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "minItems": 5, "maxItems": 8, "items": {"type": "string"}}
            ]
          },
          "feedback": {"$ref": "feedback.schema.json"},
          "accepted_at": {"type": "string", "format": "date-time"},
          "solved": {"type": "boolean"}
        }
      }
    },
    "challenge_setup": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expires_at", "own_challenge_committed", "committed_count", "required_count"],
          "properties": {
            "expires_at": {"type": "string", "format": "date-time"},
            "own_challenge_committed": {"type": "boolean"},
            "committed_count": {"type": "integer", "minimum": 0, "maximum": 8},
            "required_count": {"type": "integer", "minimum": 1, "maximum": 8},
            "is_creator": {"type": "boolean"},
            "creator_participant_id": {"type": ["string", "null"], "format": "uuid"}
          }
        }
      ]
    },
    "result": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "winner_participant_ids", "reason", "secret_revealed"],
          "properties": {
            "outcome": {"enum": ["won", "lost", "draw", "unsolved", "abandoned", "voided"]},
            "winner_participant_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
            "reason": {"enum": ["solved", "deadline", "attempt_limit", "abandoned", "not_enough_players", "voided"]},
            "secret_revealed": {"type": "boolean"},
            "winner_solve_duration_seconds": {"type": ["integer", "null"], "minimum": 0},
            "revealed_secret": {
              "oneOf": [
                {"type": "string"},
                {"type": "array", "minItems": 5, "maxItems": 8, "items": {"type": "string"}}
              ]
            }
          }
        }
      ]
    },
    "latest_sequence": {"type": "integer", "minimum": 0},
    "available_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["start", "ready", "unready", "commit_challenge", "submit_guess", "leave", "request_rematch", "next_round"]}
    },
    "round_number": {"type": "integer", "minimum": 1},
    "total_rounds": {"type": "integer", "minimum": 1},
    "creator_participant_id": {"type": ["string", "null"], "format": "uuid"},
    "scores": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "round_state": {"enum": ["creator_setup", "countdown", "active", "round_finished", "match_finished"]}
  }
}
