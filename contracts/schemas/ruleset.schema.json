{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://think-fast.local/contracts/v1/ruleset.schema.json",
  "title": "NumberRuleSetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preset_id", "game_type", "match_mode", "schema_version",
    "evaluator_version", "sequence_length", "allow_leading_zero",
    "allow_duplicates", "max_symbol_repetition", "feedback_policy",
    "history_policy", "match_deadline_seconds", "attempt_limit"
  ],
  "properties": {
    "preset_id": {"type": "string", "minLength": 1},
    "game_type": {"const": "number"},
    "match_mode": {"enum": ["practice", "friendly"]},
    "schema_version": {"const": 1},
    "evaluator_version": {"const": 1},
    "sequence_length": {"enum": [5, 6]},
    "allow_leading_zero": {"const": false},
    "allow_duplicates": {"const": true},
    "max_symbol_repetition": {"const": 2},
    "feedback_policy": {"const": "positional"},
    "history_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "full"}}
    },
    "match_deadline_seconds": {"enum": [180, 240]},
    "attempt_limit": {"enum": [12, 15]}
  }
}
