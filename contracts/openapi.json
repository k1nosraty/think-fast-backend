{
  "openapi": "3.1.0",
  "info": {
    "title": "Think Fast API",
    "version": "v1.0.0-draft.1",
    "description": "Frozen T0 contract baseline. Operations are implemented in later Backend tasks."
  },
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/guest-sessions/": {
      "post": {
        "operationId": "createGuestSession",
        "summary": "Create a temporary guest identity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CreateGuestSession"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Guest identity created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GuestSession"}}}
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "429": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/game-definitions/": {
      "get": {
        "operationId": "listGameDefinitions",
        "summary": "List available versioned presets",
        "responses": {
          "200": {
            "description": "Available definitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["contract_version", "definitions"],
                  "properties": {
                    "contract_version": {"const": "v1.0.0-draft.1"},
                    "definitions": {"type": "array", "items": {"$ref": "#/components/schemas/GameDefinition"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/solo-matches/": {
      "post": {
        "operationId": "createSoloMatch",
        "summary": "Create and activate a Solo Number match",
        "security": [{"guestBearer": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command_id", "preset_id"],
                "properties": {
                  "command_id": {"type": "string", "format": "uuid"},
                  "preset_id": {"enum": ["number_classic_5_v1", "number_brain_burner_6_v1"]}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solo match created",
            "content": {"application/json": {"schema": {"$ref": "./schemas/snapshot.schema.json"}}}
          },
          "200": {
            "description": "Existing Solo match returned for the same command ID",
            "content": {"application/json": {"schema": {"$ref": "./schemas/snapshot.schema.json"}}}
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"},
          "429": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/rooms/": {
      "post": {
        "operationId": "createRoom",
        "summary": "Create a private Friendly room",
        "security": [{"guestBearer": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/CreateRoomCommand"}}
          }
        },
        "responses": {
          "201": {
            "description": "Room created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomSnapshot"}}}
          },
          "200": {"description": "Existing Room returned for the same command ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomSnapshot"}}}},
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "429": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/rooms/{room_id}/": {
      "get": {
        "operationId": "getRoomSnapshot",
        "summary": "Get an authorized Room snapshot for lobby recovery",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RoomId"}],
        "responses": {
          "200": {"description": "Authorized Room snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomSnapshot"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/rooms/{room_id}/join/": {
      "post": {
        "operationId": "joinRoom",
        "summary": "Join a private room after resolving its invite code",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RoomId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandIdentity"}}}
        },
        "responses": {
          "200": {"description": "Joined", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomSnapshot"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"},
          "429": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/rooms/{room_id}/ready/": {
      "post": {
        "operationId": "setRoomReady",
        "summary": "Set participant readiness for the current rules",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RoomId"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {"$ref": "#/components/schemas/CommandIdentity"},
                  {"type": "object", "required": ["ready"], "properties": {"ready": {"type": "boolean"}}}
                ]
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Readiness updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomSnapshot"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/rooms/{room_id}/start/": {
      "post": {
        "operationId": "startRoomMatch",
        "summary": "Freeze room rules/participants and start countdown",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RoomId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandIdentity"}}}},
        "responses": {
          "201": {"description": "Match created", "content": {"application/json": {"schema": {"$ref": "./schemas/snapshot.schema.json"}}}},
          "200": {"description": "Existing Match returned for the same command ID", "content": {"application/json": {"schema": {"$ref": "./schemas/snapshot.schema.json"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/rooms/{room_id}/leave/": {
      "post": {
        "operationId": "leaveRoom",
        "summary": "Leave a waiting room and transfer host ownership when required",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RoomId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandIdentity"}}}},
        "responses": {
          "200": {"description": "Room membership removed; returns the updated Room or closed state"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/matches/{match_id}/guesses/": {
      "post": {
        "operationId": "submitGuess",
        "summary": "Submit an idempotent Guess command",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/MatchId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "./schemas/guess-command.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Guess accepted as an Attempt", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttemptOutcome"}}}},
          "200": {"description": "Existing outcome returned for the same command ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttemptOutcome"}}}},
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"},
          "429": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/matches/{match_id}/snapshot/": {
      "get": {
        "operationId": "getMatchSnapshot",
        "summary": "Get viewer-authorized state for load or recovery",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/MatchId"}],
        "responses": {
          "200": {"description": "Authorized snapshot", "content": {"application/json": {"schema": {"$ref": "./schemas/snapshot.schema.json"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/matches/{match_id}/leave/": {
      "post": {
        "operationId": "leaveMatch",
        "summary": "Leave or abandon a Match according to its state",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/MatchId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandIdentity"}}}},
        "responses": {
          "200": {"description": "Updated viewer snapshot", "content": {"application/json": {"schema": {"$ref": "./schemas/snapshot.schema.json"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/matches/{match_id}/rematch/": {
      "post": {
        "operationId": "requestRematch",
        "summary": "Request or accept a new Match in the existing Room",
        "security": [{"guestBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/MatchId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandIdentity"}}}},
        "responses": {
          "202": {"description": "Rematch request recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomSnapshot"}}}},
          "401": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "guestBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque-guest-token"}
    },
    "parameters": {
      "RoomId": {"name": "room_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "MatchId": {"name": "match_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "responses": {
      "ApiError": {
        "description": "Stable API error",
        "content": {"application/json": {"schema": {"$ref": "./schemas/error.schema.json"}}}
      }
    },
    "schemas": {
      "CommandIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id"],
        "properties": {"command_id": {"type": "string", "format": "uuid"}}
      },
      "CreateGuestSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "avatar_id"],
        "properties": {
          "display_name": {"type": "string", "minLength": 3, "maxLength": 20},
          "avatar_id": {"type": "string", "minLength": 1}
        }
      },
      "GuestSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["guest_id", "display_name", "avatar_id", "access_token", "expires_at"],
        "properties": {
          "guest_id": {"type": "string", "format": "uuid"},
          "display_name": {"type": "string"},
          "avatar_id": {"type": "string"},
          "access_token": {"type": "string"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      },
      "GameDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset_id", "display_name_key", "rules"],
        "properties": {
          "preset_id": {"type": "string"},
          "display_name_key": {"type": "string"},
          "rules": {"$ref": "./schemas/ruleset.schema.json"}
        }
      },
      "CreateRoomCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "preset_id"],
        "properties": {
          "command_id": {"type": "string", "format": "uuid"},
          "preset_id": {"enum": ["number_classic_5_v1", "number_brain_burner_6_v1"]}
        }
      },
      "RoomSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": ["room_id", "join_code", "host_participant_id", "preset_id", "state", "latest_sequence", "members"],
        "properties": {
          "room_id": {"type": "string", "format": "uuid"},
          "join_code": {"type": "string", "pattern": "^[A-HJ-NP-Z2-9]{6}$"},
          "host_participant_id": {"type": "string", "format": "uuid"},
          "preset_id": {"type": "string"},
          "state": {"enum": ["waiting", "ready_check", "countdown", "active", "closed"]},
          "latest_sequence": {"type": "integer", "minimum": 0},
          "members": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["participant_id", "display_name", "avatar_id", "ready", "connected"],
              "properties": {
                "participant_id": {"type": "string", "format": "uuid"},
                "display_name": {"type": "string"},
                "avatar_id": {"type": "string"},
                "ready": {"type": "boolean"},
                "connected": {"type": "boolean"}
              }
            }
          }
        }
      },
      "AttemptOutcome": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "attempt_id", "ordinal", "feedback", "solved", "match_state", "latest_sequence"],
        "properties": {
          "command_id": {"type": "string", "format": "uuid"},
          "attempt_id": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 1},
          "feedback": {"$ref": "./schemas/feedback.schema.json"},
          "solved": {"type": "boolean"},
          "match_state": {"enum": ["active", "finishing", "finished"]},
          "latest_sequence": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
