# Think Fast Backend Environment Configuration
# Copy this file to .env and fill in the values for local development.

# Django settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=think_fast
POSTGRES_USER=think_fast
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1

# Redis (for Channels and caching)
REDIS_URL=redis://127.0.0.1:6379/0

# Security
GAME_SECRET_ENCRYPTION_KEY=change-me-to-a-32-byte-key
METRICS_BEARER_TOKEN=change-me

# Application
LOG_LEVEL=INFO

# Game timers (configurable expiry/grace)
FRIENDLY_COUNTDOWN_SECONDS=5
PLAYER_CHALLENGE_SETUP_SECONDS=120
PARTY_SETUP_DURATION_SECONDS=90
PARTY_ROUND_DURATION_SECONDS=60
FRIENDLY_DISCONNECT_GRACE_SECONDS=30
REMATCH_REQUEST_TTL_SECONDS=60
WS_TICKET_TTL_SECONDS=30

# Reliability worker
RELIABILITY_WORKER_INTERVAL_SECONDS=1
RESYNC_MAX_EVENTS=100
RESYNC_BATCH_SIZE=50
RESYNC_RATE_LIMIT_COUNT=10
RESYNC_RATE_LIMIT_WINDOW_SECONDS=10
